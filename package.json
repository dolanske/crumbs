{
  "name": "@dolanske/crumbs",
  "type": "module",
  "version": "3.0.0",
  "private": false,
  "description": "SPA router for framework-less web applications using HTML files.",
  "author": "dolanske",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dolanske/crumbs.git"
  },
  "keywords": [
    "javascript",
    "typescript",
    "SPA",
    "router"
  ],
  "exports": {
    ".": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js"
    },
    "./client": "./client.d.ts"
  },
  "main": "./dist/router.js",
  "module": "./dist/router.js",
  "types": "./dist/router.d.ts",
  "files": [
    "client.d.ts",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.8.3",
    "@types/node": "^20.11.30",
    "eslint": "^8.57.0",
    "happy-dom": "^20.14.3",
    "typescript": "^5.4.2",
    "vite": "^5.2.2",
    "vite-plugin-dts": "^3.7.3",
    "vitest": "^1.4.0"
  }
}
